{
  "name": "LumiClass 课表",
  "short_name": "LumiClass",
  "description": "离线可用的七列课表：切周、编辑课程、作业提醒、相册与纪念日。",
  "lang": "zh-CN",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#fff0f5",
  "theme_color": "#b9537f",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "作业提醒",
      "short_name": "作业",
      "description": "查看作业与截止时间",
      "url": "./index.html?tab=assign",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "我们的相册",
      "short_name": "相册",
      "description": "看照片、设为课表背景",
      "url": "./index.html?tab=album",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "学期设置",
      "short_name": "设置",
      "description": "学期周数、作息时间、背景",
      "url": "./index.html?tab=settings",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
